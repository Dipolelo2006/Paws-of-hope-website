/* ---------- 1. CSS RESET ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ---------- 2. ROOT / COLOUR SCHEME (from proposal) ---------- */
: root {
  --terracotta: #C2703A;
  --sage: #7A9E7E;
  --cream: #F8F4EF;
  --charcoal: #333333;
  --white: #ffffff;
  --light-grey: #f0ebe3;
  --dark-sage: #5c7a60;
  --shadow: rgba(51, 51, 51, 0.12);
}

/* ---------- 3. BASE STYLES ---------- */
html {
  font-size: 16px;
  scroll-behavior: smooth;
}

body {
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  font-size: 1rem;
  line-height: 1.6;
  color: var(--charcoal);
  background-color: var(--cream);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
  border-radius: 8px;
}

a {
  color: var(--terracotta);
  text-decoration: none;
  transition: color 0.25s ease;
}

a: hover,
a: focus {
  color: var(--dark-sage);
  text-decoration: underline;
}

ul, ol {
  margin-left: 1.25rem;
  margin-bottom: 1rem;
}

/* ---------- 4. TYPOGRAPHY ---------- */
h1, h2, h3, h4 {
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.3;
  color: var(--charcoal);
  margin-bottom: 0.75rem;
}

h1 {
  font-size: 1.75rem;
  color: var(--terracotta);
}

h2 {
  font-size: 1.5rem;
  border-bottom: 3px solid var(--sage);
  padding-bottom: 0.35rem;
  margin-top: 1.5rem;
}

h3 {
  font-size: 1.25rem;
  color: var(--dark-sage);
}

p {
  margin-bottom: 1rem;
}

/* ---------- 5. HEADER & NAVIGATION ---------- */
header {
  background-color: var(--white);
  border-bottom: 4px solid var(--terracotta);
  padding: 1rem 1.5rem;
  box-shadow: 0 2px 8px var(--shadow);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.logo h1 {
  margin: 0;
  font-size: 1.4rem;
  border: none;
}

nav ul {
  list-style: none;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
}

nav a {
  font-weight: 600;
  color: var(--charcoal);
  padding: 0.35rem 0.6rem;
  border-radius: 4px;
  transition: background-color 0.25s ease, color 0.25s ease;
}

nav a:hover,
nav a:focus {
  background-color: var(--sage);
  color: var(--white);
  text-decoration: none;
}

/* ---------- 6. MAIN CONTENT & LAYOUT ---------- */
main {
  flex: 1;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem;
}

section {
  background-color: var(--white);
  border-radius: 10px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 2px 10px var(--shadow);
}

/* Hero section */
#hero {
  text-align: center;
  background: linear-gradient(135deg, var(--cream), var(--light-grey));
}

#hero img {
  margin: 0 auto 1.25rem;
  max-height: 380px;
  object-fit: cover;
  width: 100%;
}

#hero h2 {
  border: none;
  color: var(--terracotta);
  font-size: 1.8rem;
}

#hero p a {
  display: inline-block;
  margin: 0.4rem 0.5rem;
  padding: 0.55rem 1.2rem;
  background-color: var(--terracotta);
  color: var(--white);
  border-radius: 6px;
  font-weight: 600;
  transition: background-color 0.25s ease, transform 0.2s ease;
}

#hero p a:hover {
  background-color: var(--dark-sage);
  text-decoration: none;
  transform: translateY(-2px);
}

/* Stats section */
#stats ul {
  list-style: none;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
}

#stats li {
  background-color: var(--light-grey);
  padding: 1rem;
  border-radius: 8px;
  text-align: center;
  border-left: 4px solid var(--sage);
}

#stats strong {
  display: block;
  font-size: 1.4rem;
  color: var(--terracotta);
}

/* Animal cards (animals.html) */
.animal-card {
  background-color: var(--cream);
  border: 1px solid #e0d8ce;
  border-radius: 10px;
  padding: 1.25rem;
  margin-bottom: 1.5rem;
  transition: box-shadow 0.25s ease, transform 0.2s ease;
}

.animal-card:hover {
  box-shadow: 0 6px 18px var(--shadow);
  transform: translateY(-3px);
}

.animal-card img {
  margin-bottom: 0.75rem;
  max-height: 260px;
  object-fit: cover;
  width: 100%;
}

/* Forms */
form {
  max-width: 560px;
}

label {
  display: block;
  font-weight: 600;
  margin-top: 0.75rem;
  margin-bottom: 0.25rem;
}

input[type="text"],
input[type="email"],
input[type="tel"],
textarea,
select {
  width: 100%;
  padding: 0.55rem 0.75rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
  font-family: inherit;
  background-color: var(--white);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: var(--sage);
  box-shadow: 0 0 0 3px rgba(122, 158, 126, 0.25);
}

button,
input[type="submit"] {
  display: inline-block;
  margin-top: 1.25rem;
  padding: 0.65rem 1.5rem;
  background-color: var(--terracotta);
  color: var(--white);
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.25s ease, transform 0.2s ease;
}

button:hover,
input[type="submit"]:hover {
  background-color: var(--dark-sage);
  transform: translateY(-2px);
}

/* ---------- 7. FOOTER ---------- */
footer {
  background-color: var(--charcoal);
  color: var(--cream);
  text-align: center;
  padding: 1.25rem 1rem;
  margin-top: auto;
  font-size: 0.9rem;
}

footer p {
  margin-bottom: 0.35rem;
}

footer a {
  color: var(--sage);
}

/* ---------- 8. RESPONSIVE DESIGN ---------- */

/* Tablet (max-width: 900px) */
@media screen and (max-width: 900px) {
  header {
    flex-direction: column;
    text-align: center;
  }

  nav ul {
    justify-content: center;
  }

  main {
    padding: 1rem;
  }

  #hero h2 {
    font-size: 1.5rem;
  }

  #stats ul {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile (max-width: 600px) */
@media screen and (max-width: 600px) {
  html {
    font-size: 15px;
  }

  .logo h1 {
    font-size: 1.2rem;
  }

  nav ul {
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  nav a {
    display: block;
    width: 100%;
    text-align: center;
  }

  #hero img {
    max-height: 240px;
  }

  #hero h2 {
    font-size: 1.3rem;
  }

  #hero p a {
    display: block;
    margin: 0.5rem 0;
  }

  #stats ul {
    grid-template-columns: 1fr;
  }

  section {
    padding: 1rem;
  }

  h2 {
    font-size: 1.3rem;
  }
}

/* =========================================================
   PART 3 – Interactive Features, Forms & Lightbox
   ========================================================= */

/* Lightbox */
#lightbox-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

#lightbox-overlay.active {
  display: flex;
}

.lightbox-content {
  position: relative;
  max-width: 90vw;
  max-height: 90vh;
}

#lightbox-img {
  max-width: 100%;
  max-height: 85vh;
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

#lightbox-close {
  position: absolute;
  top: -12px;
  right: -12px;
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 50%;
  background: var(--terracotta);
  color: white;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  z-index: 1;
}

#lightbox-close:hover {
  background: var(--dark-sage);
}

/* Search box */
.search-box {
  margin: 1rem 0 1.5rem;
}

.search-box label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.35rem;
}

.search-box input {
  width: 100%;
  max-width: 360px;
  padding: 0.55rem 0.75rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
}

.search-box input:focus {
  outline: none;
  border-color: var(--sage);
  box-shadow: 0 0 0 3px rgba(122, 158, 126, 0.25);
}

/* Accordion */
.accordion-list {
  list-style: none;
  margin-left: 0;
}

.accordion-item {
  margin-bottom: 0.5rem;
  border: 1px solid #e0d8ce;
  border-radius: 8px;
  overflow: hidden;
}

.accordion-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  background: var(--light-grey);
  border: none;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
  color: var(--charcoal);
}

.accordion-btn:hover {
  background: #e8e2d8;
}

.accordion-panel {
  display: none;
  padding: 0.75rem 1rem 1rem;
  background: var(--white);
}

.accordion-panel.open {
  display: block;
}

/* Form validation feedback */
.error-field {
  border-color: #c0392b !important;
  box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.2) !important;
}

.error-message {
  display: block;
  color: #c0392b;
  font-size: 0.875rem;
  margin-top: 0.25rem;
  margin-bottom: 0.5rem;
}

.success-message {
  margin-top: 1.25rem;
  padding: 1rem 1.25rem;
  background: #e8f5e9;
  border: 1px solid var(--sage);
  border-left: 4px solid var(--sage);
  border-radius: 6px;
  color: var(--charcoal);
}
